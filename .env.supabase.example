# COPY THIS FILE TO .env.supabase; keep .env.supabase private.
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Copy YOUR actual host and the username postgres.<PROJECT-REF>.
# JDBC URL MUST contain sslmode=require AND currentSchema=crm_app.
# We intentionally use a private schema, not Supabase's public Data API schema.
# Do not put passwords in the URL.
DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require&currentSchema=crm_app
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_DATABASE_PASSWORD

# CRM sign-in is separate from your Supabase credentials.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_PASSWORD

# Keep SMS preview-only until an authorised test send is required.
SMS_MODE=preview
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
SMS_FROM=
